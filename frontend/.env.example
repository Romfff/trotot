# Server-side only. Next.js Route Handlers call the backend directly.
BACKEND_API_URL=http://localhost:5000/api/v1
FRONTEND_ORIGIN=http://localhost:3000
# Match the backend value. Server-only; generate a random secret for deployment.
BFF_PROXY_SECRET=local-only-replace-with-shared-bff-secret-32-chars
# Leave empty locally. In deployment, use a single-IP header overwritten by your edge proxy.
TRUSTED_CLIENT_IP_HEADER=
