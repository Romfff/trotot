# Server-side only. Auth and public listing Route Handlers call the backend directly.
# Browsers use same-origin /api/auth and /api/listings; no NEXT_PUBLIC_API_URL needed.
# Public Socket.io origin for payment/calendar/chat, not credentials. For local chat use http://localhost:5000 and backend REALTIME_ENABLED=true. Blank disables realtime.
NEXT_PUBLIC_PAYMENT_REALTIME_URL=
BACKEND_API_URL=http://localhost:5000/api/v1
FRONTEND_ORIGIN=http://localhost:3000
# Match the backend value. Server-only; generate a random secret for deployment.
BFF_PROXY_SECRET=local-only-replace-with-shared-bff-secret-32-chars
# Leave empty locally. In deployment, use a single-IP header overwritten by your edge proxy.
TRUSTED_CLIENT_IP_HEADER=
# Server-only Nearby Places presentation; backend must be enabled with a reviewed dataset.
NEARBY_ENABLED=false
# Optional isolated production checks while next dev is running. Default .next.
# FRONTEND_BUILD_DIR=.next-nearby-test
