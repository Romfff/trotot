  batchId String @map("batch_id") @db.Uuid
  item FinancePayoutItem @relation(fields:[itemId],references:[id],onDelete:Restrict)
  journal FinanceJournal @relation(fields:[journalId],references:[id],onDelete:Restrict)
  confirmation FinancePayoutConfirmation @relation(fields:[batchId],references:[batchId],onDelete:Restrict)
  @@map("finance_payout_paid_items")
}
model FinanceComplaintResolution {
  complaintId String @id @map("complaint_id") @db.Uuid
  eventId String @unique @map("event_id") @db.Uuid
  actorId String @map("actor_id") @db.Uuid
  decision String @db.VarChar(20)
  versionBefore Int @map("version_before")
  reason String @db.VarChar(500)
  evidenceNote String @map("evidence_note") @db.VarChar(500)
  createdAt DateTime @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(6)
  createdTxid BigInt @default(dbgenerated("txid_current()")) @map("created_txid")
  complaint FinanceComplaint @relation(fields:[complaintId],references:[id],onDelete:Restrict)
  event FinanceComplaintEvent @relation(fields:[eventId],references:[id],onDelete:Restrict)
  actor User @relation(fields:[actorId],references:[id],onDelete:Restrict)
  @@map("finance_complaint_resolutions")
}

// Exact committed HTTP response retained for 7 days, scoped to actor + operation + key.
model BookingIdempotency {
  id             String @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId         String @map("user_id") @db.Uuid
  operation      String @db.VarChar(30)
  key            String @db.VarChar(128)
  requestHash    String @map("request_hash") @db.Char(64)
  responseStatus Int @map("response_status")
  responseBody   Json @map("response_body") @db.JsonB
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(6)
  user           User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, operation, key])
  @@index([expiresAt])
  @@map("booking_idempotency")
}
