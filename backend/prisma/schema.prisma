generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  phone               String         @unique @db.VarChar(20)
  email               String?        @unique @db.VarChar(255)
  passwordHash        String         @map("password_hash") @db.VarChar(255)
  sessionVersion      Int            @default(0) @map("session_version")
  fullName            String         @map("full_name") @db.VarChar(150)
  role                String         @default("TENANT") @db.VarChar(20)
  avatarUrl           String?        @map("avatar_url")
  isPhoneVerified     Boolean?       @default(false) @map("is_phone_verified")
  isIdentityVerified  Boolean?       @default(false) @map("is_identity_verified")
  status              String?        @default("ACTIVE") @db.VarChar(20)
  createdAt           DateTime?      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime?      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  hostProfile         HostProfile?
  refreshTokens       RefreshToken[]

  @@map("users")
}

model HostProfile {
  userId             String   @id @map("user_id") @db.Uuid
  bankCode           String?  @map("bank_code") @db.VarChar(20)
  bankAccountNumber  String?  @map("bank_account_number") @db.VarChar(50)
  bankAccountName    String?  @map("bank_account_name") @db.VarChar(150)
  balanceWallet      Decimal  @default(0) @map("balance_wallet") @db.Decimal(18, 2)
  payoutSchedule     String?  @map("payout_schedule") @db.VarChar(20)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("host_profiles")
}

model RefreshToken {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("refresh_tokens")
}
