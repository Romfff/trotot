{
  "name": "trotot-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "prisma generate && nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "prestart:dev": "prisma generate",
    "start:prod": "node dist/main.js",
    "lint": "oxlint src test scripts prisma.config.ts prisma/seed.ts",
    "test": "vitest run",
    "test:integration": "node test/run-auth-integration.mjs",
    "test:listings:integration": "node test/run-listings-integration.mjs",
    "test:homestay:browser:integration": "node test/run-homestay-browser-integration.mjs",
    "test:booking:coverage": "node test/run-booking-coverage.mjs",
    "test:booking:unit:coverage": "node test/run-booking-unit-coverage.mjs",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "seed:dev": "tsx prisma/seed.ts",
    "seed:listings:local": "tsx scripts/seed-local-listings.ts",
    "test:auth:browser:integration": "node test/run-auth-browser-integration.mjs",
    "test:backup:integration": "node test/backup.integration.mjs",
    "test:runtime:restart": "node test/runtime-restart.integration.mjs",
    "test:admin:browser:integration": "node test/run-admin-browser-integration.mjs",
    "test:reviews:integration": "node test/run-reviews-integration.mjs",
    "test:chat:integration": "node test/run-chat-integration.mjs",
    "test:catalog": "vitest run test/address-catalog.test.mjs",
    "catalog:check": "node scripts/check-address-catalog.mjs",
    "test:catalog:integration": "node test/address-catalog.integration.mjs",
    "test:seo:browser:integration": "node test/run-seo-browser-integration.mjs",
    "test:lighthouse:integration": "node test/run-lighthouse-integration.mjs",
    "test:docker:integration": "node test/docker-app.integration.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.2",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.3.11",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cloudinary": "^2.7.0",
    "dotenv": "^17.2.0",
    "file-type": "^21.0.0",
    "ioredis": "^5.8.0",
    "jose": "^6.1.0",
    "pg": "^8.16.0",
    "redlock": "^5.0.0-beta.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "socket.io": "4.8.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@vitest/coverage-istanbul": "^5.0.2",
    "oxlint": "^1.80.0",
    "prisma": "^7.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.1",
    "mysql2": "^3.24.0"
  }
}
