# Local development only. Replace every development value before sharing or deploying.
NODE_ENV=development
PORT=5000
# Local loopback remains the default; container package overrides binding internally.
LISTEN_HOST=127.0.0.1
# Empty by default. Trust only the exact ingress proxy IP/CIDR; never wildcard or hop count.
TRUSTED_PROXY_CIDRS=
API_PREFIX=api/v1
BFF_PROXY_SECRET=local-only-replace-with-shared-bff-secret-32-chars
CORS_ORIGINS=http://localhost:3000

POSTGRES_DB=trotot
POSTGRES_USER=trotot
POSTGRES_PASSWORD=trotot_local_dev_only
POSTGRES_PORT=5432
DATABASE_URL=postgresql://trotot:trotot_local_dev_only@localhost:5432/trotot?schema=public
# Per API process, 1-50. Keep headroom for workers/replicas and the DB connection budget.
DATABASE_POOL_MAX=10

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_local_dev_only

# Generate independent random values of at least 32 characters for a real environment.
JWT_ACCESS_SECRET=local-only-replace-with-random-access-secret-32-chars
JWT_REFRESH_SECRET=local-only-replace-with-random-refresh-secret-32-chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
# Separate signing key for 15-minute homestay quotes; never reuse either JWT secret.
HOMESTAY_QUOTE_SECRET=local-only-replace-with-independent-quote-secret-32-chars
BOOKING_ALLOW_UNCONFIGURED_PAYMENT=false
BOOKING_MIN_NIGHTLY_PRICE=1

OTP_PROVIDER=mock
OTP_TTL_SECONDS=300
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5

# Cloudinary credentials are deliberately blank. Set CLOUDINARY_URL outside Git to enable uploads.
CLOUDINARY_URL=
MAX_UPLOAD_BYTES=10485760
MAX_UPLOAD_FILES=8
ALLOW_DEV_SEED=false

# Viewing appointments: Vietnam timezone. Business defaults approved D04, not booking inventory.
APPOINTMENT_MIN_LEAD_MINUTES=120
APPOINTMENT_MAX_DAYS=30
APPOINTMENT_STEP_MINUTES=30
APPOINTMENT_OPEN_TIME=07:00:00
APPOINTMENT_CLOSE_TIME=21:00:00
APPOINTMENT_TENANT_PENDING_LIMIT=5
APPOINTMENT_PROPERTY_PENDING_LIMIT=20
# Cost-estimate input ceilings (D12); approved parking rate is VND per vehicle/month.
ESTIMATE_MAX_ELECTRICITY_KWH=10000
ESTIMATE_MAX_WATER_M3=1000
ESTIMATE_MAX_OCCUPANTS=20
ESTIMATE_MAX_VEHICLES=10
# Contact reveal only; temporary 60-second IP/account buckets, no lead storage.
LISTING_CONTACT_IP_LIMIT_PER_MINUTE=10
LISTING_CONTACT_USER_LIMIT_PER_MINUTE=5

# VNPay Sandbox is disabled until server-only credentials and HTTPS callback URLs exist.
# Never put these values in NEXT_PUBLIC_* or commit a populated .env.
VNPAY_SANDBOX_ENABLED=false
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_RETURN_URL=
VNPAY_IPN_IP_LIMIT_PER_MINUTE=240
# Authenticated Socket.io payment/calendar/chat hints. Enable for realtime chat; same CORS_ORIGINS as HTTP.
REALTIME_ENABLED=false

# Nearby Places: enable only after its migrations and a reviewed dataset are ready.
# Keep false until source-quality acceptance. Must match the frontend server flag.
NEARBY_ENABLED=false
